# Server
NODE_ENV=development
PORT=5000

# Database
# Local:   mongodb://127.0.0.1:27017/warehouse-sim
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/warehouse-sim
# Use a SEPARATE database for development/staging. Never point a dev server
# at the production cluster.
MONGO_URI=mongodb://127.0.0.1:27017/warehouse-sim

# --- Authentication secrets ------------------------------------------------
# REQUIRED in production - the server refuses to boot without them, rather
# than silently falling back to a default that would be identical on every
# deployment. Outside production a random value is generated per process
# (so tokens simply do not survive a restart locally).
#
# Generate each one separately - they must NOT be the same value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Two keys, not one: a leaked access secret must not also let an attacker
# mint refresh tokens. Rotating either signs everyone out, which is the
# intended emergency response to a suspected leak.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes, in seconds. Short access tokens keep the blast radius of
# a leaked one small; the rotating refresh token is what keeps a user
# signed in.
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=2592000
# JWT_ISSUER=warehouse-robot-simulation
# JWT_AUDIENCE=warehouse-robot-simulation-client

# bcrypt work factor. Raise as hardware improves; 12 is a reasonable 2026
# default. Tests drop this to 4 for speed.
# BCRYPT_ROUNDS=12

# Per-account login throttling (complements the per-IP rate limiter).
# MAX_FAILED_LOGINS=8
# LOGIN_LOCKOUT_SECONDS=900

# --- Cookies ---------------------------------------------------------------
# Vercel and Render are different registrable domains, so the auth cookies
# are cross-site in production and must be SameSite=None, which browsers
# only permit together with Secure. Both are derived from NODE_ENV by
# default; override only if you know why you need to.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# COOKIE_DOMAIN=

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. REQUIRED in production:
# the server refuses to boot without it rather than falling back to an open
# policy, because this API is credentialed and a permissive CORS policy on a
# credentialed API lets any site act as a signed-in user.
# Origins only - scheme + host + port, no trailing slash or path.
CLIENT_ORIGINS=http://localhost:5173

# Socket.IO
SOCKET_PATH=/socket.io
# How often the server-owned per-warehouse tick loop advances the
# simulation, in milliseconds (Milestone 11). Leave unset for the 500ms
# default.
# TICK_INTERVAL_MS=500

# --- Rate limiting ---------------------------------------------------------
# Registrations allowed per hour, per IP. The default of 5 is the production
# value and production keeps it whatever this says: env.js ignores the
# override when NODE_ENV=production, because this limit is what stops the
# registration endpoint being used to discover which email addresses have
# accounts.
#
# Raise it only on a disposable dev or staging backend, and only to run the
# browser-driven end-to-end suite - those tests register real accounts
# through the real form, which five per hour cannot support. See
# frontend/tests/e2e/global-setup.js.
# REGISTER_RATE_LIMIT_MAX=5
