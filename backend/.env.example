# Server
NODE_ENV=development
PORT=5000

# Database
# Local:   mongodb://127.0.0.1:27017/warehouse-sim
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/warehouse-sim
# Use a SEPARATE database for development/staging. Never point a dev server
# at the production cluster.
MONGO_URI=mongodb://127.0.0.1:27017/warehouse-sim

# --- Authentication secrets ------------------------------------------------
# REQUIRED in production - the server refuses to boot without them, rather
# than silently falling back to a default that would be identical on every
# deployment. Outside production a random value is generated per process
# (so tokens simply do not survive a restart locally).
#
# Generate each one separately - they must NOT be the same value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Two keys, not one: a leaked access secret must not also let an attacker
# mint refresh tokens. Rotating either signs everyone out, which is the
# intended emergency response to a suspected leak.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes, in seconds. Short access tokens keep the blast radius of
# a leaked one small; the rotating refresh token is what keeps a user
# signed in.
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=2592000
# JWT_ISSUER=warehouse-robot-simulation
# JWT_AUDIENCE=warehouse-robot-simulation-client

# bcrypt work factor. Raise as hardware improves; 12 is a reasonable 2026
# default. Tests drop this to 4 for speed.
# BCRYPT_ROUNDS=12

# Per-account login throttling (complements the per-IP rate limiter).
# MAX_FAILED_LOGINS=8
# LOGIN_LOCKOUT_SECONDS=900

# --- Cookies ---------------------------------------------------------------
# Vercel and Render are different registrable domains, so the auth cookies
# are cross-site in production and must be SameSite=None, which browsers
# only permit together with Secure. Both are derived from NODE_ENV by
# default; override only if you know why you need to.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# COOKIE_DOMAIN=

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. REQUIRED in production:
# the server refuses to boot without it rather than falling back to an open
# policy, because this API is credentialed and a permissive CORS policy on a
# credentialed API lets any site act as a signed-in user.
# Origins only - scheme + host + port, no trailing slash or path.
CLIENT_ORIGINS=http://localhost:5173

# Socket.IO
SOCKET_PATH=/socket.io
# How often the server-owned per-warehouse tick loop advances the
# simulation, in milliseconds (Milestone 11). Leave unset for the 500ms
# default.
# TICK_INTERVAL_MS=500

# --- Rate limiting ---------------------------------------------------------
# Registrations allowed per hour, per IP. The default of 5 is the production
# value and production keeps it whatever this says: env.js ignores the
# override when NODE_ENV=production, because this limit is what stops the
# registration endpoint being used to discover which email addresses have
# accounts.
#
# Raise it only on a disposable dev or staging backend, and only to run the
# browser-driven end-to-end suite - those tests register real accounts
# through the real form, which five per hour cannot support. See
# frontend/tests/e2e/global-setup.js.
# REGISTER_RATE_LIMIT_MAX=5

# --- Rate-limit storage ----------------------------------------------------
# `express-rate-limit`'s default memory store is per process: limits are not
# shared across instances and reset on every restart and redeploy. That was
# accurate-but-fragile on a single instance and simply wrong with two.
# `mongo` keeps the counters in the database this app already has - shared
# and durable, without adding Redis to the stack. Defaults to mongo in
# production and memory elsewhere.
# RATE_LIMIT_STORE=mongo

# --- Account recovery, verification and MFA --------------------------------
# Outbound mail, behind a transport seam (src/services/mailer.js):
#   console  write the message - link and all - to the server log. The
#            default outside production; what makes these flows usable on a
#            laptop with no mail account.
#   webhook  POST the message to MAIL_WEBHOOK_URL. Enough to wire this to a
#            real provider or a queue without an SMTP dependency.
#   none     drop it (the production default, so a deployment cannot ship a
#            password reset that silently does not work by inheriting
#            `console` and never noticing).
# Production must choose explicitly: a reset link printed to a log nobody
# reads is not a delivered email.
# MAIL_TRANSPORT=webhook
# MAIL_WEBHOOK_URL=
# MAIL_WEBHOOK_TOKEN=
# MAIL_WEBHOOK_TIMEOUT_MS=5000

# Where the links in those emails point - the frontend origin. Defaults to
# the first CLIENT_ORIGINS entry.
# APP_BASE_URL=https://your-frontend.vercel.app

# A reset token is a live credential (whoever holds it becomes the user), so
# it is short lived. A verification token is not, and a user may not read
# their mail for a day.
# PASSWORD_RESET_TTL_SECONDS=1800
# EMAIL_VERIFICATION_TTL_SECONDS=86400

# Whether an unverified address may use the API at all. Off by default:
# turning it on without a working mail transport locks every account out of
# a system that was working a moment ago.
# REQUIRE_EMAIL_VERIFICATION=false

# TOTP. One step either side (+/- 30 seconds) absorbs ordinary clock drift;
# widening it multiplies the guess space.
# TOTP_WINDOW=1
# MFA_RECOVERY_CODE_COUNT=10

# How many distinct source networks one account tracks failed logins for.
# Lockout is per source rather than per account, so knowing someone's email
# is not enough to keep them out of their own account; this bounds the
# growth an attacker rotating addresses can force on one document.
# MAX_LOGIN_FAILURE_BUCKETS=20

# --- Simulation runtime ----------------------------------------------------
# The engine cache is bounded by both an idle TTL and a count. A warehouse
# that is actively ticking is pinned and never evicted, so these only govern
# warehouses nobody is running. Zero disables either half.
# MAX_CACHED_ENGINES=64
# ENGINE_IDLE_TTL_MS=1800000

# How long a simulation may keep running with nobody watching it
# (`simulation:start` with `background: true`). Unattended work needs a
# ceiling or a forgotten browser tab ticks a warehouse for the life of the
# process.
# MAX_BACKGROUND_SECONDS=3600

# The largest step a single tick may apply. The automatic loop measures real
# elapsed time rather than assuming its own cadence, so a stalled process
# would otherwise come back and advance the world by however long it was
# gone. Capping turns that into a bounded catch-up.
# MAX_TICK_DELTA_SECONDS=2

# Cross-process warehouse leases. One Node process may own a warehouse's
# tick loop at a time; a second instance running against the same database
# declines to tick a warehouse another instance holds rather than running a
# second simulation of it. On by default outside tests. Turn it off only for
# a deployment you know is single-instance and has no shared database.
# SIMULATION_LEASES=true
# SIMULATION_LEASE_TTL_SECONDS=30
